+/*
+ * Restrict the experimental native transport to exactly two desktop GA106s.
+ * Explicit administrator overrides keep their stock behavior. This policy
+ * selects the mailbox protocol, not a system-memory view of peer VRAM.
+ * Capability advertisement is provisional until the CUDA integrity test passes.
+ */
+static NvBool
+_ga106NativePeerMask(NvU32 gpuMask)
+{
+    NvU32 instance = 0;
+    OBJGPU *a;
+    OBJGPU *b;
+    KernelBif *bifA;
+    KernelBif *bifB;
+
+    if (gpumgrGetSubDeviceCount(gpuMask) != 2)
+        return NV_FALSE;
+    a = gpumgrGetNextGpu(gpuMask, &instance);
+    b = gpumgrGetNextGpu(gpuMask, &instance);
+    if (!ga106NativePeerPair(a, b))
+        return NV_FALSE;
+
+    bifA = GPU_GET_KERNEL_BIF(a);
+    bifB = GPU_GET_KERNEL_BIF(b);
+    return bifA->p2pOverride == BIF_P2P_NOT_OVERRIDEN &&
+           bifB->p2pOverride == BIF_P2P_NOT_OVERRIDEN &&
+           bifA->forceP2PType == NV_REG_STR_RM_FORCE_P2P_TYPE_DEFAULT &&
+           bifB->forceP2PType == NV_REG_STR_RM_FORCE_P2P_TYPE_DEFAULT &&
+           bifA->pcieP2PType == NV_REG_STR_RM_PCIEP2P_TYPE_MAILBOX &&
+           bifB->pcieP2PType == NV_REG_STR_RM_PCIEP2P_TYPE_MAILBOX;
+}
+
