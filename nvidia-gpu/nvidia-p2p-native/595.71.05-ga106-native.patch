@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: MIT
+// Experimental GA106-only native PCIe peer policy. No BAR1 identity remapping.
+#ifndef GA106_NATIVE_PEER_H
+#define GA106_NATIVE_PEER_H
+
+#include "gpu/gpu.h"
+#include "gpu/bif/kernel_bif.h"
+#include "published/nv_arch.h"
+
+static inline NvBool ga106NativePeerGpu(OBJGPU *pGpu)
+{
+    return pGpu != NULL &&
+           gpuGetChipArch(pGpu) == GPU_ARCHITECTURE_AMPERE &&
+           gpuGetChipImpl(pGpu) == GPU_IMPLEMENTATION_GA106 &&
+           IS_GSP_CLIENT(pGpu) && !IS_VIRTUAL(pGpu) && !IsMobile(pGpu) &&
+           !gpuIsCCFeatureEnabled(pGpu) && !gpuIsSelfHosted(pGpu);
+}
+
+static inline NvBool ga106NativePeerPair(OBJGPU *a, OBJGPU *b)
+{
+    return a != b && ga106NativePeerGpu(a) && ga106NativePeerGpu(b) &&
+           gpuGetDomain(a) == gpuGetDomain(b);
+}
+
+#endif
